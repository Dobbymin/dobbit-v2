// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// User Management
// ============================================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nickname     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  cashBalance      CashBalance?
  wallets          Wallet[]
  trades           Trade[]
  balanceHistories BalanceHistory[]
  alertRules       AlertRule[]
  notifications    Notification[]
  slackIntegration SlackIntegration?

  @@map("users")
}

// ============================================================================
// Wallet & Balance Management
// ============================================================================

model CashBalance {
  id        String   @id @default(cuid())
  userId    String   @unique
  amount    Decimal  @db.Decimal(18, 8)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cash_balances")
}

model Wallet {
  id           String   @id @default(cuid())
  userId       String
  marketId     String
  quantity     Decimal  @db.Decimal(18, 8)
  averagePrice Decimal  @db.Decimal(18, 8)
  totalCost    Decimal  @db.Decimal(18, 8)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  market Market @relation(fields: [marketId], references: [id], onDelete: Restrict)

  @@unique([userId, marketId])
  @@index([userId])
  @@map("wallets")
}

model BalanceHistory {
  id            String   @id @default(cuid())
  userId        String
  marketId      String?
  changeType    String // TRADE_BUY, TRADE_SELL, INITIAL_GRANT, ADJUSTMENT
  quantityDelta Decimal  @db.Decimal(18, 8)
  cashDelta     Decimal  @db.Decimal(18, 8)
  reason        String?
  tradeId       String?
  createdAt     DateTime @default(now())

  // Relations
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade Trade? @relation(fields: [tradeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tradeId])
  @@map("balance_histories")
}

// ============================================================================
// Market & Trading
// ============================================================================

model Market {
  id          String   @id @default(cuid())
  code        String   @unique
  symbol      String   @unique
  koreanName  String
  englishName String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  wallets           Wallet[]
  trades            Trade[]
  alertRules        AlertRule[]
  snapshots         MarketSnapshot[]
  notifications     Notification[]
  newsMarketTags    NewsMarketTag[]
  predictionReviews PredictionReview[]

  @@map("markets")
}

model Trade {
  id          String   @id @default(cuid())
  userId      String
  marketId    String
  type        String // BUY, SELL
  price       Decimal  @db.Decimal(18, 8)
  quantity    Decimal  @db.Decimal(18, 8)
  totalAmount Decimal  @db.Decimal(18, 8)
  fee         Decimal  @db.Decimal(18, 8)
  executedAt  DateTime
  createdAt   DateTime @default(now())

  // Relations
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  market           Market           @relation(fields: [marketId], references: [id], onDelete: Restrict)
  balanceHistories BalanceHistory[]

  @@index([userId])
  @@index([marketId])
  @@index([executedAt])
  @@map("trades")
}

model MarketSnapshot {
  id                String   @id @default(cuid())
  marketId          String
  tradePrice        Decimal  @db.Decimal(18, 8)
  signedChangeRate  Decimal  @db.Decimal(8, 4)
  accTradeVolume24h Decimal  @db.Decimal(18, 2)
  snapshotAt        DateTime
  createdAt         DateTime @default(now())

  // Relations
  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId])
  @@index([snapshotAt])
  @@map("market_snapshots")
}

// ============================================================================
// News & Analysis
// ============================================================================

model NewsArticle {
  id          String   @id @default(cuid())
  source      String // naver, etc.
  title       String
  url         String   @unique
  publisher   String?
  publishedAt DateTime
  content     String   @db.Text
  summary     String   @db.Text
  rawPayload  Json?
  collectedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  marketTags NewsMarketTag[]
  analyses   NewsAnalysis[]

  @@index([publishedAt])
  @@index([source])
  @@map("news_articles")
}

model NewsMarketTag {
  id            String   @id @default(cuid())
  newsArticleId String
  marketId      String
  symbol        String
  confidence    Decimal  @db.Decimal(5, 4)
  createdAt     DateTime @default(now())

  // Relations
  newsArticle NewsArticle @relation(fields: [newsArticleId], references: [id], onDelete: Cascade)
  market      Market      @relation(fields: [marketId], references: [id], onDelete: Restrict)

  @@unique([newsArticleId, marketId])
  @@index([marketId])
  @@map("news_market_tags")
}

model NewsAnalysis {
  id              String   @id @default(cuid())
  newsArticleId   String
  provider        String // HERMES, GEMINI
  sentiment       String // POSITIVE, NEUTRAL, NEGATIVE
  confidence      Decimal  @db.Decimal(5, 4)
  investmentScore Decimal  @db.Decimal(5, 4)
  keywords        String[] @default([])
  reason          String   @db.Text
  modelVersion    String
  analyzedAt      DateTime
  createdAt       DateTime @default(now())

  // Relations
  newsArticle      NewsArticle       @relation(fields: [newsArticleId], references: [id], onDelete: Cascade)
  predictionReview PredictionReview?

  @@unique([newsArticleId, provider, modelVersion])
  @@index([newsArticleId])
  @@index([provider])
  @@index([sentiment])
  @@map("news_analyses")
}

model NewsAnalysisRun {
  id           String    @id @default(cuid())
  provider     String // HERMES, GEMINI
  status       String // PENDING, RUNNING, SUCCEEDED, FAILED, PARTIAL_SUCCESS
  targetDate   DateTime
  requestedBy  String // SCHEDULE, MANUAL
  totalCount   Int       @default(0)
  successCount Int       @default(0)
  failedCount  Int       @default(0)
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([provider])
  @@index([status])
  @@index([targetDate])
  @@map("news_analysis_runs")
}

model PredictionReview {
  id                 String   @id @default(cuid())
  newsAnalysisId     String   @unique
  marketId           String
  basePrice          Decimal  @db.Decimal(18, 8)
  futurePrice        Decimal  @db.Decimal(18, 8)
  timeHorizon        String // 1H, 4H, 1D
  predictedDirection String // UP, DOWN, FLAT
  actualDirection    String // UP, DOWN, FLAT
  isMatched          Boolean
  errorRate          Decimal  @db.Decimal(5, 4)
  reviewedAt         DateTime
  createdAt          DateTime @default(now())

  // Relations
  newsAnalysis NewsAnalysis @relation(fields: [newsAnalysisId], references: [id], onDelete: Cascade)
  market       Market       @relation(fields: [marketId], references: [id], onDelete: Restrict)

  @@index([marketId])
  @@index([reviewedAt])
  @@map("prediction_reviews")
}

model LearningSample {
  id                 String   @id @default(cuid())
  newsAnalysisId     String?
  predictionReviewId String?
  inputSnapshot      Json
  expectedOutput     Json
  actualOutput       Json
  feedbackLabel      String // GOOD, BAD, NEEDS_REVIEW
  createdAt          DateTime @default(now())

  @@index([feedbackLabel])
  @@map("learning_samples")
}

// ============================================================================
// Alerts & Notifications
// ============================================================================

model AlertRule {
  id              String    @id @default(cuid())
  userId          String
  marketId        String
  type            String // PRICE_CHANGE_RATE, PROFIT_RATE_TARGET, LOSS_RATE_LIMIT, VOLUME_SPIKE, NEWS_SENTIMENT
  threshold       Decimal   @db.Decimal(8, 4)
  comparison      String // GTE, LTE
  enabled         Boolean   @default(true)
  sendInApp       Boolean   @default(true)
  sendSlack       Boolean   @default(false)
  cooldownSeconds Int       @default(0)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  market        Market         @relation(fields: [marketId], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@unique([userId, marketId, type])
  @@index([userId])
  @@index([marketId])
  @@index([enabled])
  @@map("alert_rules")
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  alertRuleId String?
  marketId    String?
  title       String
  message     String    @db.Text
  severity    String // INFO, WARNING, CRITICAL
  payload     Json?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  // Relations
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertRule  AlertRule?             @relation(fields: [alertRuleId], references: [id], onDelete: SetNull)
  market     Market?                @relation(fields: [marketId], references: [id], onDelete: SetNull)
  deliveries NotificationDelivery[]

  @@index([userId])
  @@index([alertRuleId])
  @@index([marketId])
  @@index([readAt])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String    @id @default(cuid())
  notificationId String
  channel        String // WEBSOCKET, SLACK
  status         String // PENDING, SENT, FAILED
  errorMessage   String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  // Relations
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([notificationId])
  @@index([status])
  @@map("notification_deliveries")
}

// ============================================================================
// Slack Integration
// ============================================================================

model SlackIntegration {
  id                  String    @id @default(cuid())
  userId              String    @unique
  webhookUrlEncrypted String
  channelName         String?
  enabled             Boolean   @default(false)
  lastTestedAt        DateTime?
  lastErrorMessage    String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("slack_integrations")
}
